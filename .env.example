# ====================================================================
# IntlRoam API v2 环境变量
# 复制为 .env，按实际填写
# ====================================================================

# ---------- 运行环境 ----------
ENV=production
LOG_LEVEL=info
TZ=Asia/Hong_Kong

# ---------- 监听 ----------
APP_HOST=127.0.0.1
APP_PORT=8000
APP_WORKERS=2

# ---------- 数据库（与 chatwoot_deploy 共用宿主机 PG）----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=intlroam
POSTGRES_PASSWORD=__FILL_FROM_chatwoot.env__
POSTGRES_DB=intlroam

# ---------- Redis（与 chatwoot_deploy 共用，DB 0 给 FastAPI）----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- LLM ----------
LLM_PRIMARY=gemini
LLM_FALLBACK=deepseek

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek (OpenAI 兼容协议)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# LLM 参数
LLM_TIMEOUT=10
LLM_MAX_RETRIES=2

# ---------- 业务配置 ----------
# 群组锁 TTL（秒），避免多机同时采同一群
GROUP_LOCK_TTL_SECONDS=1800

# 单设备每日评论上限
MAX_DAILY_COMMENTS_FB=15
MAX_DAILY_COMMENTS_IG=15

# ---------- 安全 ----------
# 简易 API token（手机端在请求头 X-Device-Token 里带，与设备绑定）
# 留空则不验证（仅 Tailscale 内网使用时可不验）
DEVICE_TOKEN_REQUIRED=false
